  "components": {
    "schemas": {
      "AssertUrl": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$",
            "title": "Id"
          },
          "timeout_ms": {
            "type": "integer",
            "maximum": 30000.0,
            "minimum": 1.0,
            "title": "Timeout Ms"
          },
          "action": {
            "type": "string",
            "const": "assert_url",
            "title": "Action"
          },
          "path": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "pattern": "^/",
            "title": "Path"
          },
          "oracle_ref": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 3,
                "pattern": "^[A-Z][A-Z0-9_-]*@[1-9][0-9]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Oracle Ref"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "timeout_ms",
          "action",
          "path",
          "oracle_ref"
        ],
        "title": "AssertUrl"
      },
      "AssertVisible": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$",
            "title": "Id"
          },
          "timeout_ms": {
            "type": "integer",
            "maximum": 30000.0,
            "minimum": 1.0,
            "title": "Timeout Ms"
          },
          "action": {
            "type": "string",
            "const": "assert_visible",
            "title": "Action"
          },
          "target": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RoleTarget"
              },
              {
                "$ref": "#/components/schemas/TextTarget"
              }
            ],
            "title": "Target",
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "role": "#/components/schemas/RoleTarget",
                "text": "#/components/schemas/TextTarget"
              }
            }
          },
          "oracle_ref": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 3,
                "pattern": "^[A-Z][A-Z0-9_-]*@[1-9][0-9]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Oracle Ref"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "timeout_ms",
          "action",
          "target",
          "oracle_ref"
        ],
        "title": "AssertVisible"
      },
      "AttemptResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "assessment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assessment"
          },
          "receipt": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "title": "Receipt"
          },
          "steps": {
            "items": {
              "additionalProperties": {
                "$ref": "#/components/schemas/JsonValue"
              },
              "type": "object"
            },
            "type": "array",
            "title": "Steps"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "assessment",
          "receipt",
          "steps"
        ],
        "title": "AttemptResponse"
      },
      "Case": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Title"
          },
          "intent": {
            "type": "string",
            "enum": [
              "requirement",
              "exploratory"
            ],
            "title": "Intent"
          },
          "steps": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Navigate"
                },
                {
                  "$ref": "#/components/schemas/Click"
                },
                {
                  "$ref": "#/components/schemas/Fill"
                },
                {
                  "$ref": "#/components/schemas/AssertVisible"
                },
                {
                  "$ref": "#/components/schemas/AssertUrl"
                }
              ],
              "discriminator": {
                "propertyName": "action",
                "mapping": {
                  "assert_url": "#/components/schemas/AssertUrl",
                  "assert_visible": "#/components/schemas/AssertVisible",
                  "click": "#/components/schemas/Click",
                  "fill": "#/components/schemas/Fill",
                  "navigate": "#/components/schemas/Navigate"
                }
              }
            },
            "type": "array",
            "maxItems": 12,
            "minItems": 1,
            "title": "Steps"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "intent",
          "steps"
        ],
        "title": "Case"
      },
      "Click": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$",
            "title": "Id"
          },
          "timeout_ms": {
            "type": "integer",
            "maximum": 30000.0,
            "minimum": 1.0,
            "title": "Timeout Ms"
          },
          "action": {
            "type": "string",
            "const": "click",
            "title": "Action"
          },
          "target": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RoleTarget"
              },
              {
                "$ref": "#/components/schemas/TextTarget"
              }
            ],
            "title": "Target",
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "role": "#/components/schemas/RoleTarget",
                "text": "#/components/schemas/TextTarget"
              }
            }
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "timeout_ms",
          "action",
          "target"
        ],
        "title": "Click"
      },
      "EmptyInput": {
        "properties": {},
        "additionalProperties": false,
        "type": "object",
        "title": "EmptyInput"
      },
      "EventResponse": {
        "properties": {
          "state": {
            "type": "string",
            "title": "State"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "state",
          "created_at"
        ],
        "title": "EventResponse"
      },
      "Fill": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$",
            "title": "Id"
          },
          "timeout_ms": {
            "type": "integer",
            "maximum": 30000.0,
            "minimum": 1.0,
            "title": "Timeout Ms"
          },
          "action": {
            "type": "string",
            "const": "fill",
            "title": "Action"
          },
          "target": {
            "$ref": "#/components/schemas/RoleTarget"
          },
          "value": {
            "type": "string",
            "maxLength": 256,
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "timeout_ms",
          "action",
          "target",
          "value"
        ],
        "title": "Fill"
      },
      "FindingList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/FindingResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "FindingList"
      },
      "FindingResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "oracle_ref": {
            "type": "string",
            "title": "Oracle Ref"
          },
          "machine_state": {
            "type": "string",
            "title": "Machine State"
          },
          "reproduced": {
            "type": "boolean",
            "title": "Reproduced"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "review_state": {
            "type": "string",
            "title": "Review State"
          },
          "review_sequence": {
            "type": "integer",
            "title": "Review Sequence"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed"
          },
          "evidence_available": {
            "type": "boolean",
            "title": "Evidence Available"
          },
          "manifest": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "title": "Manifest"
          },
          "manifest_sha256": {
            "type": "string",
            "title": "Manifest Sha256"
          },
          "oracle": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue"
                },
                "type": "object"
