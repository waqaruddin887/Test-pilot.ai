# Local development only. Never commit actual credentials.
TESTPILOT_DATABASE_URL=sqlite:///.runtime/testpilot.db
TESTPILOT_DATA_DIR=.runtime
TESTPILOT_UI_ORIGIN=http://localhost:3000
# Generate using: python -c 'import secrets; print(secrets.token_urlsafe(32))'
TESTPILOT_OPERATOR_SECRET=
# CLI bearer credential; browser uses an expiring HttpOnly session + CSRF.
TESTPILOT_CLI_TOKEN=
# Planned mode is intentionally unavailable; no provider calls or costs enabled.
TESTPILOT_PLANNER=deterministic_smoke
# Optional Postgres adapter (requires a running operator-managed server):
# TESTPILOT_DATABASE_URL=postgresql+psycopg://testpilot:CHANGE_ME@localhost/testpilot
# Optional single-host RQ JSON notification transport. Keep one worker/data directory.
TESTPILOT_QUEUE_TRANSPORT=local
# Required only when transport=redis; use an authenticated private Redis service.
# TESTPILOT_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
